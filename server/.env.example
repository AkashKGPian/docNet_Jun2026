# DocNet MVP — Server Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/docnet?retryWrites=true&w=majority

# JWT secret — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# JWT expiry
JWT_EXPIRES_IN=7d

# ────────────────────────────────────────────────────────
# THIRD PARTY APIs
# ────────────────────────────────────────────────────────

# Hugging Face Inference API Key (optional — not used for canvas OCR; client uses Tesseract.js)
# Get yours here: https://huggingface.co/settings/tokens
# HF_API_KEY=your_hugging_face_key_here

# Google Gemini API Key (for Grammar Fix & Headings)
# Get yours here: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=5000

# Client URL (for CORS) — must match Vite port in client/vite.config.js
CLIENT_URL=http://localhost:5174

# Node environment
NODE_ENV=development

# Platform admin bootstrap (run: node scripts/createPlatformAdmin.js)
# PLATFORM_ADMIN_EMAIL=platform@docnet.com
# PLATFORM_ADMIN_PASSWORD=change_me_in_production

# ────────────────────────────────────────────────────────
# AWS S3 + CloudFront (profile photos — required in production)
# ────────────────────────────────────────────────────────
# On EC2, use an IAM instance role instead of access keys.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=docnet-profile-photos-yourname-prod
AWS_CLOUDFRONT_URL=https://d1234abcd.cloudfront.net
# Optional — only if not using EC2 IAM role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ────────────────────────────────────────────────────────
# Auth cookies (production)
# ────────────────────────────────────────────────────────
# Secure cookies require HTTPS. For Elastic-IP-only HTTP staging, set:
# COOKIE_SECURE=false
# Remove or set true once domain + HTTPS (Certbot) is configured.
# COOKIE_SECURE=false
