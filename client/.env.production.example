# DocNet MVP — Client production build (Elastic IP phase)
# Copy to client/.env.production before `npm run build` on EC2.
# Replace YOUR_ELASTIC_IP with your allocated Elastic IP.

VITE_API_URL=http://YOUR_ELASTIC_IP/api
VITE_SOCKET_URL=http://YOUR_ELASTIC_IP

# After domain + HTTPS (Phase 5), rebuild with:
# VITE_API_URL=https://yourdomain.com/api
# VITE_SOCKET_URL=https://yourdomain.com
