# DocNet MVP — Client Environment Variables
# Copy to client/.env.local for local development.
#
# DocNet frontend runs on port 5174 (see vite.config.js).
# Open: http://localhost:5174

# REST API base URL (must include /api)
VITE_API_URL=http://localhost:5000/api

# Socket.IO server URL (no /api suffix)
VITE_SOCKET_URL=http://localhost:5000
