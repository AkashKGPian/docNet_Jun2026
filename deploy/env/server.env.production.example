# DocNet MVP — server/.env on EC2 (production)
# Copy to /home/ubuntu/DocNetMVP/server/.env — NEVER commit real values.

MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/docnet?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_64
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=production
CLIENT_URL=http://YOUR_ELASTIC_IP

AWS_REGION=ap-south-1
AWS_S3_BUCKET=docnet-profile-photos-yourname-prod
AWS_CLOUDFRONT_URL=https://dxxxx.cloudfront.net

# Elastic-IP HTTP staging only — remove after HTTPS + domain
COOKIE_SECURE=false

# Optional third-party APIs
HF_API_KEY=
GEMINI_API_KEY=
